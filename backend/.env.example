# Variables del motor de datos. Copie a `.env` para uso local, o péguelas en el
# panel del proveedor donde esté alojado el motor (Render, Railway, Fly.io…).
#
# Ninguna es obligatoria: sin ellas el motor arranca con los valores por
# omisión y sólo queda desactivado el historial.

# Dominios autorizados a llamar a la API, separados por comas. En producción
# debe ser el dominio exacto del sitio de Netlify.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL del historial. Vacío = la aplicación funciona igual, sin historial.
#
# Con Supabase, use la cadena del *pooler* (IPv4). La conexión directa
# (db.<ref>.supabase.co) sólo resuelve por IPv6 y falla en Render y similares.
# Si la contraseña lleva @ : / # ? & %, hay que codificarla en la URL.
# Cómo obtenerla, paso a paso: docs/supabase.md
#
# DATABASE_URL=postgresql://postgres.<REF>:<CLAVE>@<REGION>.pooler.supabase.com:5432/postgres

# Límites de ingesta y de historial.
MAX_UPLOAD_BYTES=26214400
MAX_BYTES_HISTORIAL=8388608
MAX_HISTORIAL=25
